.","bullet":"black","level":0,"lineid":null,"text_rendered":"Put the waste into the green bin or garbage."}],"guideid":182595,"stepid":389756,"orderby":4,"revisionid":3642296,"pending_patrol":{"gsr":null,"gst":null},"media":{"type":"image","data":[{"id":3565859,"guid":"ART2RM6gM22rFmcA","mini":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.mini","thumbnail":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.thumbnail","140x105":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.140x105","200x150":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.200x150","standard":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.standard","440x330":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.440x330","medium":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.medium","large":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.large","huge":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.huge","original":"https://guide-images.cdn.ifixit.com/igi/ART2RM6gM22rFmcA.full"}]},"comments":[]},{"title":"","lines":[{"text_raw":"Under the sink next to the dishwasher should be the water outlet hose that connects the dishwasher to the kitchen sink drain pipe.","bullet":"icon_note","level":0,"lineid":null,"text_rendered":"Under the sink next to the dishwasher should be the water outlet hose that connects the dishwasher to the kitchen sink drain pipe."},{"text_raw":"Remove all the content in front of the outlet hose in order to have proper access to the outlet hose.","bullet":"black","level":0,"lineid":null,"text_rendered":"Remove all the content in front of the outlet hose in order to have proper access to the outlet hose."},{"text_raw":"There should be a clamp on the outlet hose to keep it attached to the drain pipe.","bullet":"icon_note","level":0,"lineid":null,"text_rendered":"There should be a clamp on the outlet hose to keep it attached to the drain pipe."},{"text_raw":"Place a towel under the outlet hose in case 